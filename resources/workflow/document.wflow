				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"

if curl -s --max-time 0.5 http://127.0.0.1:8787/health &gt;/dev/null 2&gt;&amp;1; then
    "$HOME/.local/bin/raz" stop &gt;/dev/null 2&gt;&amp;1
    osascript -e 'display notification "Raz apagado" with title "Raz"'
else
    nohup "$HOME/.local/bin/raz" start &gt;/dev/null 2&gt;&amp;1 &amp;
    osascript -e 'display notification "Activando Raz..." with title "Raz"'
fi</string>
					<key>CheckedForUserDefaultShell</key>
